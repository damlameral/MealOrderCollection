@{
    Layout = "_Layout";
}
@model List<MealOrder>

<div class="p-4 mb-4 bg-light rounded-3 text-center border">
    <h2>@ViewBag.CafeteriaName</h2>
    <p class="text-muted">Date: <strong>@ViewBag.CurrentDate</strong></p>
    <div class="alert alert-success d-inline-block">
        Total Picked Up Orders: <strong>@ViewBag.DeliveredCount</strong>
    </div>
</div>

<h3>Picked Up Orders</h3>

@if (Model.Count == 0)
{
    <p>No picked up orders found yet.</p>
}
else
{
    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>Order ID</th>
                <th>Student Name</th>
                <th>Meal Name</th>
                <th>Pickup Date & Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.OrderID</strong></td>
                    <td>@item.StudentName</td>
                    <td>@item.MealName</td>
                    <td>@item.CollectedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}