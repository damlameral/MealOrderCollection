@{
    Layout = "_Layout";
}
@model MealOrder

<div class="card mt-4 shadow-sm">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Meal Collection Information (#@Model.OrderID)</h4>
    </div>
    <div class="card-body">
        <p><strong>Student Name:</strong> @Model.StudentName</p>
        <p><strong>Meal Name:</strong> @Model.MealName</p>
        
        <p><strong>Status:</strong> 
            @if (Model.Collected)
            {
                <span class="badge bg-success fs-6">Picked Up</span>
            }
            else
            {
                <span class="badge bg-warning text-dark fs-6">Not Picked Up</span>
            }
        </p>

        <p><strong>Collection Date & Time:</strong>
            @if (Model.Collected && Model.CollectedAt != null)
            {
                <span class="text-success fw-bold">@Model.CollectedAt.Value.ToString("dd.MM.yyyy HH:mm:ss")</span>
            }
            else
            {
                <span class="text-danger fst-italic">This meal has not been picked up yet.</span>
            }
        </p>
    </div>
    <div class="card-footer bg-light">
        <a href="/Order/Index" class="btn btn-secondary">← Back to All Orders</a>
    </div>
</div>