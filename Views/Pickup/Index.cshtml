@{
    Layout = "_Layout";
}
@{
    ViewBag.Title = "Meal Pickup";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Meal Pickup Counter</h4>
            </div>
            <div class="card-body">
                <p class="text-muted">Enter your Order ID to collect your prepared meal.</p>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <form asp-action="Index" method="post">
                    <div class="mb-3">
                        <label for="orderId" class="form-label fw-bold">Order ID:</label>
                        <input type="text" name="orderId" id="orderId" class="form-control" placeholder="e.g. O002" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Pick Up Meal</button>
                </form>
            </div>
        </div>
    </div>
</div>